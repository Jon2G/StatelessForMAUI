<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SampleApp.Views.DrawingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:SampleApp.Views"
    xmlns:vm="clr-namespace:SampleApp.ViewModels"
    Padding="20"
    x:DataType="views:DrawingViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <Label Grid.Row="0" Text="{Binding NestedLevel}" />
        <toolkit:DrawingView
            Grid.Row="1"
            IsMultiLineModeEnabled="True"
            Lines="{Binding Lines, Mode=TwoWay}" />
        <VerticalStackLayout Grid.Row="1" Spacing="20">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="20">

                <Button Command="{Binding ClearCommand}" Text="Clear" />

                <Button
                    Grid.Column="1"
                    Clicked="AnotherPageClicked"
                    Text="Open another page" />
            </Grid>

        </VerticalStackLayout>

    </Grid>

</ContentPage>
